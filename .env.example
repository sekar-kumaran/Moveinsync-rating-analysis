# .env.example
# Copy this file to .env and fill in values if needed.
# Currently, the MoveInSync review pipeline does NOT require any API keys.
# google-play-scraper uses the public Google Play web interface.

# Optional: Override default app ID
# APP_ID=com.moveinsync.ets

# Optional: Override collection language and country
# COLLECTION_LANG=en
# COLLECTION_COUNTRY=in

# Optional: Override target review count per sort order
# TARGET_COUNT=5000
